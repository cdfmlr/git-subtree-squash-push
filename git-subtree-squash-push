#!/usr/bin/env bash
# Publish a repository root or subtree to a standalone Git repository.
#
# Modes:
#   (default)    Publish normal, unsquashed history.
#   --squash     Publish one snapshot commit per invocation.
#   --squash-tags Publish one snapshot commit per tag on HEAD's first-parent
#                history; later invocations append only tags not yet published.
#
# Every generated commit is named with `git describe --tags --always --long
# --abbrev=7` of its source commit. Pinning the abbreviation keeps the name (and
# therefore the synthetic commit id) stable across clones with different object
# counts.
#
# Generated commits copy the source commit's author and committer by default;
# --author, --committer and --identity override that.
#
# -f rebuilds squashed history from scratch and force-updates the destination
# branch (using --force-with-lease). In normal mode, it force-updates the
# branch with the current root/subtree history.

set -euo pipefail

PROGRAM=${0##*/}
MODE=normal
PREFIX=''
FORCE=0
AUTHOR_SPEC=keep
COMMITTER_SPEC=keep
IDENTITY_SPEC=''
AUTHOR_SET=0
COMMITTER_SET=0
IDENTITY_SET=0

usage() {
  cat <<USAGE
Usage:
  $PROGRAM --prefix=PATH [--squash | --squash-tags] [-f] REMOTE BRANCH

Arguments:
  REMOTE   Git remote name or repository URL
  BRANCH   Destination branch name in REMOTE (a short name, e.g. "main")

Options:
  --prefix=PATH   Path relative to the repository root, or '.' for the root
  --squash        Publish the current snapshot as one commit
  --squash-tags   Publish one snapshot commit per reachable tag, in
                  first-parent history order
  --identity=SPEC Set the author and committer identity (default: keep)
  --author=SPEC   Set the author identity (default: keep)
  --committer=SPEC
                  Set the committer identity (default: keep)
  -f, --force     Rebuild squashed history from scratch and force-update the
                  remote branch; in normal mode, force-update the branch
  -h, --help      Show this help

Identity SPEC:
  keep                 reuse the source commit's author/committer (default)
  current              use the current git user (user.name / user.email)
  [fixed,]NAME <EMAIL> use the given identity; "fixed," is optional

Without --squash or --squash-tags, history is not squashed.
Squashed commits are named with `git describe --tags --always --long --abbrev=7`.
For --squash-tags, tags must be on the current HEAD's first-parent history.
--identity conflicts with --author/--committer. Identity options only apply to
--squash and --squash-tags.
USAGE
}

die() {
  printf '%s: error: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

# Parse an identity spec. On success sets IDENT_KIND (keep|current|fixed) and,
# for fixed, IDENT_NAME / IDENT_EMAIL.
parse_identity_spec() { # spec
  local spec=$1
  local re='^(.+) <([^<>[:space:]]+)>$'
  IDENT_KIND=''
  IDENT_NAME=''
  IDENT_EMAIL=''
  case $spec in
    keep|current)
      IDENT_KIND=$spec
      return 0
      ;;
    fixed,*)
      spec=${spec#fixed,}
      ;;
  esac
  [[ $spec != *$'\n'* && $spec != *$'\r'* ]] || return 1
  [[ $spec =~ $re ]] || return 1
  IDENT_KIND=fixed
  IDENT_NAME=${BASH_REMATCH[1]}
  IDENT_EMAIL=${BASH_REMATCH[2]}
}

# Read the author and committer metadata of a commit in one git call. The
# format ends with %x00 so that the last field is terminated too; without it
# `read -d ""` cannot read the final field.
read_source_meta() { # commit
  SRC_AN=''; SRC_AE=''; SRC_AD=''; SRC_CN=''; SRC_CE=''; SRC_CD=''
  { IFS= read -r -d '' SRC_AN
    IFS= read -r -d '' SRC_AE
    IFS= read -r -d '' SRC_AD
    IFS= read -r -d '' SRC_CN
    IFS= read -r -d '' SRC_CE
    IFS= read -r -d '' SRC_CD
  } < <(git show -s --format='%an%x00%ae%x00%aI%x00%cn%x00%ce%x00%cI%x00' "$1") ||
    die "cannot read commit metadata: $1"
}

# Resolve the author/committer metadata for the commit generated from $1.
# source_dates=1 keeps the source commit dates (--squash-tags), 0 uses the
# current time (--squash).
resolve_metadata() { # commit index total source_dates
  local commit=$1 source_dates=$4
  if [[ $AUTHOR_KIND == keep || $COMMITTER_KIND == keep ]] || ((source_dates)); then
    read_source_meta "$commit"
  fi
  case $AUTHOR_KIND in
    keep) META_AN=$SRC_AN; META_AE=$SRC_AE ;;
    current) META_AN=$CUR_NAME; META_AE=$CUR_EMAIL ;;
    *) META_AN=$AUTHOR_FIXED_NAME; META_AE=$AUTHOR_FIXED_EMAIL ;;
  esac
  case $COMMITTER_KIND in
    keep) META_CN=$SRC_CN; META_CE=$SRC_CE ;;
    current) META_CN=$CUR_NAME; META_CE=$CUR_EMAIL ;;
    *) META_CN=$COMMITTER_FIXED_NAME; META_CE=$COMMITTER_FIXED_EMAIL ;;
  esac
  if ((source_dates)); then
    META_AD=$SRC_CD
    META_CD=$SRC_CD
  else
    META_AD=$NOW_DATE
    META_CD=$NOW_DATE
  fi
}

# Create a commit with the resolved metadata. All six GIT_* variables are set
# explicitly so the ambient environment cannot leak into generated commits.
create_commit() { # tree message; uses META_* and PARENT_ARGS
  GIT_AUTHOR_NAME="$META_AN" GIT_AUTHOR_EMAIL="$META_AE" GIT_AUTHOR_DATE="$META_AD" \
    GIT_COMMITTER_NAME="$META_CN" GIT_COMMITTER_EMAIL="$META_CE" \
    GIT_COMMITTER_DATE="$META_CD" \
    git -c commit.gpgsign=false commit-tree "$1" \
      ${PARENT_ARGS[@]+"${PARENT_ARGS[@]}"} -m "$2"
}

# Resolve values that are shared by every generated commit in this run.
prepare_metadata() {
  CUR_NAME=''
  CUR_EMAIL=''
  if [[ $AUTHOR_KIND == current || $COMMITTER_KIND == current ]]; then
    CUR_NAME=$(git config user.name) || die "identity 'current' needs user.name to be set"
    CUR_EMAIL=$(git config user.email) || die "identity 'current' needs user.email to be set"
    [[ -n $CUR_NAME && -n $CUR_EMAIL ]] ||
      die "identity 'current' needs a non-empty user.name and user.email"
  fi
  local now
  now=$(date '+%s %z') || die 'cannot read the current time'
  NOW_DATE="@${now% *} ${now#* }"
}

while (($#)); do
  case "$1" in
    --author|--committer|--identity)
      (($# >= 2)) || die "$1 requires a value"
      set -- "$1=$2" "${@:3}"
      ;;
  esac
  case "$1" in
    --prefix=*)
      [[ -z "$PREFIX" ]] || die '--prefix was specified more than once'
      PREFIX=${1#--prefix=}
      shift
      ;;
    --prefix)
      [[ -z "$PREFIX" ]] || die '--prefix was specified more than once'
      (($# >= 2)) || die '--prefix requires a value'
      PREFIX=$2
      shift 2
      ;;
    --squash)
      [[ "$MODE" == normal ]] || die '--squash and --squash-tags are mutually exclusive'
      MODE=squash
      shift
      ;;
    --squash-tags)
      [[ "$MODE" == normal ]] || die '--squash and --squash-tags are mutually exclusive'
      MODE=squash-tags
      shift
      ;;
    --identity=*)
      ((IDENTITY_SET == 0)) || die '--identity was specified more than once'
      IDENTITY_SET=1
      IDENTITY_SPEC=${1#--identity=}
      shift
      ;;
    --author=*)
      ((AUTHOR_SET == 0)) || die '--author was specified more than once'
      AUTHOR_SET=1
      AUTHOR_SPEC=${1#--author=}
      shift
      ;;
    --committer=*)
      ((COMMITTER_SET == 0)) || die '--committer was specified more than once'
      COMMITTER_SET=1
      COMMITTER_SPEC=${1#--committer=}
      shift
      ;;
    -f|--force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -* )
      die "unknown option: $1 (see --help)"
      ;;
    *)
      break
      ;;
  esac
done

[[ -n "$PREFIX" ]] || die 'required option --prefix=PATH is missing'
(($# == 2)) || { usage >&2; exit 2; }
REMOTE=$1
BRANCH=$2
[[ -n "$REMOTE" ]] || die 'REMOTE must not be empty'
[[ -n "$BRANCH" ]] || die 'BRANCH must not be empty'
# The destination is always refs/heads/$BRANCH. A full ref would be pushed to
# refs/heads/refs/heads/... instead of the branch the user meant.
[[ "$BRANCH" != refs/* ]] || die "BRANCH must be a branch name, not a ref: $BRANCH"
git check-ref-format --branch "$BRANCH" >/dev/null 2>&1 || die "invalid branch name: $BRANCH"

# Expand the identity shorthands and validate the specs before touching refs.
if ((IDENTITY_SET)); then
  ((AUTHOR_SET == 0 && COMMITTER_SET == 0)) ||
    die '--identity cannot be combined with --author or --committer'
  AUTHOR_SPEC=$IDENTITY_SPEC
  COMMITTER_SPEC=$IDENTITY_SPEC
fi
if [[ $MODE == normal ]] && ((IDENTITY_SET || AUTHOR_SET || COMMITTER_SET)); then
  die '--identity/--author/--committer only apply to --squash and --squash-tags'
fi
parse_identity_spec "$AUTHOR_SPEC" || die "invalid author identity: $AUTHOR_SPEC"
AUTHOR_KIND=$IDENT_KIND
AUTHOR_FIXED_NAME=$IDENT_NAME
AUTHOR_FIXED_EMAIL=$IDENT_EMAIL
parse_identity_spec "$COMMITTER_SPEC" || die "invalid committer identity: $COMMITTER_SPEC"
COMMITTER_KIND=$IDENT_KIND
COMMITTER_FIXED_NAME=$IDENT_NAME
COMMITTER_FIXED_EMAIL=$IDENT_EMAIL

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die 'not inside a Git working tree'
cd "$ROOT"
git rev-parse --verify HEAD >/dev/null 2>&1 || die 'the repository has no commits yet'

# Publishing is based only on committed content. Fail rather than silently
# omitting staged, unstaged, or untracked files.
if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  die 'working tree is not clean; commit or stash changes before publishing'
fi

# Normalize common root/subdirectory spellings. Prefixes are relative to the
# repository root, even when this script is invoked from a nested directory.
if [[ "$PREFIX" == '.' || "$PREFIX" == './' || -z "$PREFIX" ]]; then
  PREFIX='.'
else
  PREFIX=${PREFIX#./}
  PREFIX=${PREFIX%/}
  [[ "$PREFIX" != /* ]] || die '--prefix must be relative to the repository root'
  [[ "$PREFIX" != '..' && "$PREFIX" != ../* && "$PREFIX" != */../* && "$PREFIX" != */.. ]] || die '--prefix must not contain .. path components'
  OBJECT_TYPE=$(git cat-file -t "HEAD:$PREFIX" 2>/dev/null) || die "prefix does not exist in HEAD: $PREFIX"
  [[ "$OBJECT_TYPE" == tree ]] || die "prefix is not a directory in HEAD: $PREFIX"
fi

DEST_REF="refs/heads/$BRANCH"

# Read the current destination branch, if it exists. Fetching the exact ref
# gives us a local object to use as the parent of incremental release commits.
REMOTE_LINE=$(git ls-remote --heads "$REMOTE" "$DEST_REF") || die "cannot access remote: $REMOTE"
REMOTE_EXISTS=0
REMOTE_PARENT=''
if [[ -n "$REMOTE_LINE" ]]; then
  REMOTE_EXISTS=1
  git fetch --no-tags "$REMOTE" "$DEST_REF" >/dev/null || die "failed to fetch $DEST_REF from $REMOTE"
  REMOTE_PARENT=$(git rev-parse --verify FETCH_HEAD) || die 'could not resolve fetched remote branch'
fi

# Return the tree snapshot for a commit/tag. For '.' the repository root tree
# is already the desired snapshot. For a subdirectory, the tree object recorded
# at that path *is* the snapshot, so no history rewrite (git subtree split) is
# needed here.
snapshot_tree() {
  local revision=$1
  local source_commit object_type

  source_commit=$(git rev-parse --verify "${revision}^{commit}") || die "not a commit: $revision"

  if [[ "$PREFIX" == '.' ]]; then
    git rev-parse --verify "${source_commit}^{tree}"
    return
  fi

  if ! git cat-file -e "$source_commit:$PREFIX" 2>/dev/null; then
    # The directory did not exist at this tag, so its snapshot is empty.
    git mktree </dev/null
    return
  fi

  object_type=$(git cat-file -t "$source_commit:$PREFIX") || die "cannot inspect $PREFIX at $revision"
  [[ "$object_type" == tree ]] || die "prefix is not a directory at $revision: $PREFIX"

  git rev-parse --verify "$source_commit:$PREFIX"
}

push_refspec() {
  local object_id=$1
  if ((FORCE)); then
    local lease
    if ((REMOTE_EXISTS)); then
      lease="$DEST_REF:$REMOTE_PARENT"
    else
      lease="$DEST_REF:"
    fi
    git push "--force-with-lease=$lease" "$REMOTE" "$object_id:$DEST_REF"
  else
    git push "$REMOTE" "$object_id:$DEST_REF"
  fi
}

prepare_metadata

case "$MODE" in
  normal)
    if [[ "$PREFIX" == '.' ]]; then
      EXPORT_COMMIT=$(git rev-parse HEAD)
    else
      EXPORT_COMMIT=$(git subtree split --prefix="$PREFIX" HEAD) || die 'git subtree split failed'
    fi
    printf 'Pushing %s to %s:%s without squashing...\n' "$PREFIX" "$REMOTE" "$BRANCH"
    push_refspec "$EXPORT_COMMIT"
    ;;

  squash)
    TREE=$(snapshot_tree HEAD)
    if ((REMOTE_EXISTS && !FORCE)); then
      REMOTE_TREE=$(git rev-parse --verify "${REMOTE_PARENT}^{tree}")
      if [[ "$TREE" == "$REMOTE_TREE" ]]; then
        printf 'Remote branch already has this snapshot; nothing to push.\n'
        exit 0
      fi
      PARENT_ARGS=(-p "$REMOTE_PARENT")
    else
      PARENT_ARGS=()
    fi

    MESSAGE=$(git describe --tags --always --long --abbrev=7 HEAD) ||
      die 'could not describe HEAD'
    resolve_metadata HEAD 0 1 0
    RELEASE=$(create_commit "$TREE" "$MESSAGE") || die 'could not create squashed commit'
    printf 'Pushing one squashed snapshot (%s) to %s:%s...\n' "$RELEASE" "$REMOTE" "$BRANCH"
    push_refspec "$RELEASE"
    ;;

  squash-tags)
    # List the tags in first-parent history order. Joining a single commit walk
    # with a single ref listing keeps this O(history + tags); running `git tag`
    # once per commit used to dominate publish time on large repositories.
    # `%(*objectname)` is the peeled commit for annotated tags and empty for
    # lightweight ones, where %(objectname) is the commit already.
    TAG_LIST=$(awk '
      NR == FNR { position[$1] = FNR; count = FNR; next }
      ($2 in position) { tags[position[$2]] = tags[position[$2]] $1 "\n" }
      END { for (i = 1; i <= count; i++) if (i in tags) printf "%s", tags[i] }
    ' \
      <(git rev-list --first-parent --reverse HEAD) \
      <(git for-each-ref --sort=refname \
          --format='%(refname:short) %(*objectname) %(objectname)' refs/tags)
    ) || die 'could not enumerate tags on HEAD first-parent history'

    TAGS=()
    while IFS= read -r tag; do
      [[ -n "$tag" ]] && TAGS+=("$tag")
    done <<<"$TAG_LIST"

    ((${#TAGS[@]} > 0)) || die 'no tags found on HEAD first-parent history'

    # Rebuild the desired tag chain deterministically on every run. Keeping the
    # source commit's identity and date (the defaults) makes each generated
    # commit ID reproducible. That lets us prove that the current remote tip is
    # part of the exact chain implied by the current local tags, and detect
    # inserted, moved, or deleted historical tags.
    TAG_COMMITS=()
    PARENT=''
    TAG_INDEX=0
    for TAG in "${TAGS[@]}"; do
      TREE=$(snapshot_tree "refs/tags/$TAG")
      SOURCE_COMMIT=$(git rev-parse --verify "refs/tags/$TAG^{commit}")
      MESSAGE=$(git describe --tags --always --long --abbrev=7 "$SOURCE_COMMIT") ||
        die "could not describe $TAG"
      resolve_metadata "$SOURCE_COMMIT" "$TAG_INDEX" "${#TAGS[@]}" 1
      if [[ -n "$PARENT" ]]; then
        PARENT_ARGS=(-p "$PARENT")
      else
        PARENT_ARGS=()
      fi
      RELEASE=$(create_commit "$TREE" "$MESSAGE") ||
        die "could not create release commit for tag $TAG"
      TAG_INDEX=$((TAG_INDEX + 1))
      TAG_COMMITS+=("$RELEASE")
      PARENT=$RELEASE
      printf 'Prepared tag %s (%s)\n' "$TAG" "$RELEASE"
    done

    FIRST_INDEX=0
    if ((REMOTE_EXISTS && !FORCE)); then
      LAST_INDEX=-1
      for i in "${!TAG_COMMITS[@]}"; do
        if [[ "${TAG_COMMITS[$i]}" == "$REMOTE_PARENT" ]]; then
          LAST_INDEX=$i
        fi
      done
      ((LAST_INDEX >= 0)) || die 'remote branch is not an ancestor of the tag history generated from current local tags; use -f to rebuild and replace it'
      FIRST_INDEX=$((LAST_INDEX + 1))
      if ((FIRST_INDEX >= ${#TAG_COMMITS[@]})); then
        printf 'Remote branch is already up to date with the latest local tag (%s).\n' "${TAGS[$((${#TAGS[@]} - 1))]}"
        exit 0
      fi
    fi

    RELEASE=${TAG_COMMITS[$((${#TAG_COMMITS[@]} - 1))]}
    if ((REMOTE_EXISTS && !FORCE)); then
      printf 'Pushing %d new tag snapshot(s), through %s, to %s:%s...\n' "$(( ${#TAG_COMMITS[@]} - FIRST_INDEX ))" "${TAGS[$((${#TAGS[@]} - 1))]}" "$REMOTE" "$BRANCH"
    else
      printf 'Pushing %d tag snapshot(s), through %s, to %s:%s...\n' "${#TAG_COMMITS[@]}" "${TAGS[$((${#TAGS[@]} - 1))]}" "$REMOTE" "$BRANCH"
    fi
    push_refspec "$RELEASE"
    ;;
esac
